---
import { useTranslations, type Lang } from '../i18n/ui';
interface Props {
  type: 'personal' | 'academico' | 'conceptual' | 'profesional';
  status?: 'en-curso' | 'en-desarrollo' | 'finalizado';
  lang?: Lang;
  inverse?: boolean;
}
const { type, status, lang = 'es', inverse = false } = Astro.props;
const t = useTranslations(lang);
---
<span class:list={['tags', { inverse }]}>
  <span class="tag" data-type={type}><span class="dot" aria-hidden="true"></span>{t(`type.${type}`)}</span>
  {status && <span class="tag tag-status">{t(`status.${status}`)}</span>}
</span>

<style>
  .tags { display: inline-flex; flex-wrap: wrap; gap: 0.4rem; }
  .tag {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500;
    letter-spacing: 0.06em; text-transform: uppercase;
    padding: 0.35rem 0.65rem; border-radius: 999px;
    background: var(--white); color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .tag .dot { width: 6px; height: 6px; }
  .tag[data-type='academico'] .dot { background: var(--navy); }
  .tag[data-type='conceptual'] .dot { background: transparent; box-shadow: inset 0 0 0 1.5px var(--violet); }
  .tag[data-type='profesional'] .dot { background: var(--lavender); }
  .tag-status { background: transparent; }
  .inverse .tag { background: rgb(255 255 255 / 0.08); color: var(--paper); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.2); }
  .inverse .tag[data-type='academico'] .dot { background: var(--lavender); }
</style>
