---
/**
 * Logotipo: wordmark «iker roque» + el punto violeta.
 * El punto es el símbolo de la marca: una idea que se cierra y se pone en marcha.
 */
interface Props { variant?: 'full' | 'mark'; class?: string }
const { variant = 'full', class: cls } = Astro.props;
---
{variant === 'full' ? (
  <span class:list={['logo', cls]} aria-label="Iker Roque">
    <span aria-hidden="true">iker roque</span><span class="logo-dot" aria-hidden="true"></span>
  </span>
) : (
  <svg class:list={['logo-mark', cls]} viewBox="0 0 64 64" role="img" aria-label="Iker Roque">
    <rect width="64" height="64" rx="14" fill="#172554" />
    <text x="12" y="45" fill="#F8F9FC" font-family="Instrument Sans Variable, sans-serif" font-weight="600" font-size="34" letter-spacing="-2">ir</text>
    <circle cx="48" cy="41" r="4.5" fill="#6955E8" />
  </svg>
)}

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.045em;
    line-height: 1;
    color: currentColor;
  }
  .logo-dot {
    width: 0.32em;
    height: 0.32em;
    margin-left: 0.08em;
    border-radius: 50%;
    background: var(--violet);
    transition: transform 0.5s var(--ease);
  }
  :global(a:hover) > .logo .logo-dot { transform: translateY(-0.35em); }
  .logo-mark { width: 40px; height: 40px; }
</style>
