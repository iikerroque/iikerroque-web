---
import Cover from './Cover.astro';
import Tag from './Tag.astro';
import { slugOf, type Project } from '../lib/content';
import { routes, useTranslations, type Lang } from '../i18n/ui';

interface Props { project: Project; index: number; lang?: Lang; size?: 'lg' | 'md'; eager?: boolean }
const { project, index, lang = 'es', size = 'md', eager = false } = Astro.props;
const { data } = project;
const slug = slugOf(project.id);
const t = useTranslations(lang);
---
<article class:list={['card', `card-${size}`]} data-reveal>
  <a href={`${routes[lang].projects}/${slug}`} aria-label={`${t('project.view')}: ${data.title}`}>
    <div style={`view-transition-name: cover-${slug}`}>
      <Cover title={data.title} cover={data.cover} alt={data.coverAlt} tone={data.tone} index={index} eager={eager} label={data.scope[0]} />
    </div>
    <div class="meta">
      <span class="label num">{String(index).padStart(2, '0')}</span>
      <div class="body">
        <h3 class="title">{data.title}</h3>
        <p class="summary">{data.summary}</p>
        <Tag type={data.type} status={data.status} lang={lang} />
      </div>
      <span class="go" aria-hidden="true">↗</span>
    </div>
  </a>
</article>

<style>
  .card a { display: block; }
  .meta {
    display: grid; grid-template-columns: 2.5rem 1fr auto; gap: 0.75rem;
    padding-top: 1.1rem; align-items: start;
  }
  .num { padding-top: 0.45rem; }
  .title { font-size: var(--step-2); letter-spacing: -0.04em; transition: color 0.3s; }
  .card-lg .title { font-size: var(--step-3); }
  .summary { color: var(--muted); margin: 0.5rem 0 0.9rem; max-width: 52ch; font-size: 0.98rem; line-height: 1.5; }
  .go {
    width: 2.5rem; height: 2.5rem; border-radius: 50%; display: grid; place-items: center;
    box-shadow: inset 0 0 0 1px var(--line); font-size: 1rem;
    transition: background 0.3s var(--ease), color 0.3s, transform 0.4s var(--ease), box-shadow 0.3s;
  }
  a:hover .title { color: var(--violet); }
  a:hover .go { background: var(--violet); color: var(--white); box-shadow: none; transform: rotate(45deg); }
</style>
