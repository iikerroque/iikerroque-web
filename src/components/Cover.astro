---
/**
 * Portada del proyecto. Si hay imagen (`cover`), la usa.
 * Si no, genera una portada tipográfica editorial con los colores de marca,
 * para que la web se vea completa mientras preparas las imágenes reales.
 */
interface Props {
  title: string;
  cover?: string;
  alt?: string;
  tone?: 'navy' | 'paper' | 'violet' | 'ink' | 'lavender';
  index?: number;
  eager?: boolean;
  label?: string;
}
const { title, cover, alt, tone = 'navy', index = 1, eager = false, label } = Astro.props;
const words = title.split(' ');
const num = String(index).padStart(2, '0');
---
<div class="cover" data-tone={tone}>
  {cover ? (
    <img src={cover} alt={alt ?? title} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} width="1600" height="1100" />
  ) : (
    <div class="gen" aria-hidden="true">
      <span class="gen-num">{num}</span>
      <span class="gen-label">{label}</span>
      <span class="gen-title">{words.map((w) => <span>{w}</span>)}</span>
      <span class="gen-ring"></span>
      <span class="gen-dot"></span>
      <span class="gen-grid"></span>
    </div>
  )}
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--navy);
    isolation: isolate;
  }
  .cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .gen { position: absolute; inset: 0; transition: transform 1.2s var(--ease); container-type: inline-size; }

  /* Tonos */
  .cover[data-tone='navy'] { --bg: var(--navy); --fg: var(--paper); --acc: var(--lavender); }
  .cover[data-tone='ink'] { --bg: var(--ink); --fg: var(--paper); --acc: var(--violet); }
  .cover[data-tone='paper'] { --bg: #eceef6; --fg: var(--navy); --acc: var(--violet); }
  .cover[data-tone='lavender'] { --bg: #dfe3fe; --fg: var(--navy); --acc: var(--violet); }
  .cover[data-tone='violet'] { --bg: linear-gradient(150deg, var(--navy) 10%, var(--violet) 130%); --fg: var(--paper); --acc: var(--lavender); }
  .cover { background: var(--bg); color: var(--fg); }

  .gen-num, .gen-label {
    position: absolute; top: 6cqi; font-family: var(--font-mono);
    font-size: max(10px, 2.4cqi); letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.8;
  }
  .gen-num { left: 6cqi; }
  .gen-label { right: 6cqi; }
  .gen-title {
    position: absolute; left: 5cqi; bottom: 4cqi; right: 5cqi;
    display: flex; flex-direction: column;
    font-weight: 600; font-size: 15cqi; line-height: 0.86; letter-spacing: -0.06em;
  }
  .gen-title span:nth-child(2) { font-family: var(--font-serif); font-style: italic; font-weight: 400; letter-spacing: -0.03em; padding-left: 0.6em; }
  .gen-ring {
    position: absolute; width: 46cqi; aspect-ratio: 1; right: -8cqi; top: -10cqi;
    border-radius: 50%; border: 1px solid var(--acc); opacity: 0.55;
  }
  .gen-dot {
    position: absolute; width: 5cqi; aspect-ratio: 1; right: 19cqi; top: 32cqi;
    border-radius: 50%; background: var(--violet);
  }
  .cover[data-tone='violet'] .gen-dot, .cover[data-tone='ink'] .gen-dot { background: var(--lavender); }
  .gen-grid {
    position: absolute; inset: 0; z-index: -1; opacity: 0.12;
    background-image: linear-gradient(var(--fg) 1px, transparent 1px);
    background-size: 100% 12.5%;
  }

  :global(a:hover) .cover img, :global(a:hover) .cover .gen { transform: scale(1.035); }
</style>
