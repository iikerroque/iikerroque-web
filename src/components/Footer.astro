---
import Logo from './Logo.astro';
import perfil from '../data/perfil.json';
import { routes, useTranslations, getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const r = routes[lang];
const socials = Object.entries(perfil.socials).filter(([, url]) => url);
const names: Record<string, string> = { linkedin: 'LinkedIn', instagram: 'Instagram', tiktok: 'TikTok', youtube: 'YouTube', x: 'X' };
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="cta">
      <p class="label lav">{t('footer.lead')}</p>
      <a href={r.contact} class="big">
        <span>{t('footer.cta')}</span><span class="big-dot" aria-hidden="true"></span>
      </a>
      <a href={`mailto:${perfil.email}`} class="mail link">{perfil.email}</a>
    </div>

    <div class="bottom">
      <Logo />
      <ul class="links" role="list">
        {socials.map(([key, url]) => (
          <li><a href={url} target="_blank" rel="me noopener noreferrer" class="link">{names[key] ?? key}</a></li>
        ))}
        <li><a href="/rss.xml" class="link">RSS</a></li>
      </ul>
      <p class="label lav">© {year} {perfil.name}. {t('footer.rights')}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy); color: var(--paper); margin-top: var(--section); }
  .cta { padding-block: clamp(4rem, 10vw, 9rem) clamp(3rem, 6vw, 5rem); }
  .lav { color: var(--lavender); }
  .big {
    display: inline-flex; align-items: baseline;
    font-size: clamp(3.5rem, 1rem + 12vw, 13rem); font-weight: 600;
    letter-spacing: -0.06em; line-height: 0.95; margin-block: 1.5rem 2rem;
    transition: color 0.4s var(--ease);
  }
  .big-dot {
    width: 0.16em; height: 0.16em; border-radius: 50%; background: var(--violet);
    margin-left: 0.04em; transition: transform 0.6s var(--ease), background 0.3s;
  }
  .big:hover { color: var(--lavender); }
  .big:hover .big-dot { transform: translateX(0.12em); background: var(--lavender); }
  .mail { display: table; font-size: var(--step-2); letter-spacing: -0.03em; }
  .big { display: flex; width: fit-content; }
  .bottom {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.15); padding-block: 1.75rem;
  }
  .links { display: flex; flex-wrap: wrap; gap: 1.25rem; list-style: none; padding: 0; font-size: 0.95rem; }
  .site-footer :global(.link:hover) { color: var(--lavender); }
</style>
