---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getIdeas, slugOf, formatDate } from '../../lib/content';
import { routes, useTranslations } from '../../i18n/ui';

const t = useTranslations('es');
const r = routes.es;
const ideas = await getIdeas('es');
const topics = ['Marketing', 'Redes sociales', 'Tecnología', 'Inteligencia artificial'];
---
<BaseLayout title="Ideas" description="Artículos, reflexiones y aprendizajes de Iker Roque sobre marketing, redes sociales, tecnología e inteligencia artificial.">
  <section class="container head">
    <p class="label" data-reveal>Blog · Ideas</p>
    <h1 class="display" data-reveal style="--i:1">Ideas<span class="serif accent"> en voz alta</span></h1>
    <p class="lead" data-reveal style="--i:2">Reflexiones, aprendizajes y análisis sobre marketing, redes sociales, tecnología e inteligencia artificial.</p>
  </section>

  <section class="container">
    {ideas.length > 0 ? (
      <ul class="list" role="list">
        {ideas.map((p) => (
          <li data-reveal>
            <a href={`${r.ideas}/${slugOf(p.id)}`}>
              <time class="label" datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
              <div>
                <h2 class="h3">{p.data.title}{p.data.draft && <span class="label draft"> · borrador</span>}</h2>
                <p class="muted">{p.data.description}</p>
              </div>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="empty" data-reveal>
        <p class="h3">{t('ideas.empty')}</p>
        <ul class="chips" role="list">{topics.map((x) => <li class="chip">{x}</li>)}</ul>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .head { padding-block: clamp(3rem, 7vw, 6rem) clamp(2.5rem, 6vw, 4.5rem); }
  .head .display { color: var(--navy); margin-block: 1.25rem 1.5rem; }
  .list { list-style: none; padding: 0; border-top: 1px solid var(--line-strong); }
  .list a {
    display: grid; grid-template-columns: 12rem 1fr auto; gap: var(--gutter); align-items: baseline;
    padding-block: 2rem; border-bottom: 1px solid var(--line); transition: padding 0.4s var(--ease);
  }
  .list h2 { transition: color 0.3s; margin-bottom: 0.5rem; }
  .list a:hover h2 { color: var(--violet); }
  .list a:hover { padding-left: 0.75rem; }
  .go { font-size: 1.4rem; transition: transform 0.4s var(--ease), color 0.3s; }
  .list a:hover .go { transform: translateX(4px); color: var(--violet); }
  .draft { color: var(--violet); }
  .empty { border-top: 1px solid var(--line-strong); padding-top: 2rem; display: grid; gap: 1.5rem; }
  @media (max-width: 760px) { .list a { grid-template-columns: 1fr auto; } .list time { grid-column: 1 / -1; } }
</style>
