---
import BaseLayout from '../layouts/BaseLayout.astro';
import Field from '../components/Field.astro';
import perfil from '../data/perfil.json';
import cv from '../data/trayectoria.json';
import habilidades from '../data/habilidades.json';

type Entry = { role?: string; title?: string; org: string; period: string; description?: string };
const sections: { id: string; title: string; items: Entry[] }[] = [
  { id: 'experiencia', title: 'Experiencia', items: cv.experience },
  { id: 'formacion', title: 'Formación', items: cv.education },
  { id: 'cursos', title: 'Cursos y formación complementaria', items: cv.courses },
];
---
<BaseLayout title="Experiencia y formación" description={`CV digital de ${perfil.name}: experiencia, formación, cursos e idiomas.`}>
  <section class="container head">
    <div class="head-row">
      <div>
        <p class="label" data-reveal>Trayectoria · CV</p>
        <h1 class="display" data-reveal style="--i:1">Experiencia <span class="serif accent">y formación</span></h1>
      </div>
      <div class="dl no-print" data-reveal style="--i:2">
        {perfil.cvFile
          ? <a href={perfil.cvFile} class="btn btn-primary" download>Descargar CV (PDF) <span class="arrow">↓</span></a>
          : <button class="btn btn-primary" data-print>Descargar como PDF <span class="arrow">↓</span></button>}
      </div>
    </div>
    <div class="print-only">
      <p class="h3">{perfil.name}</p>
      <p>{perfil.role} · {perfil.email}</p>
    </div>
    <p class="lead" data-reveal style="--i:3"><Field value={cv.summary} /></p>
  </section>

  <section class="container cv">
    {sections.map((s) => (
      <section class="cv-sec" aria-labelledby={s.id}>
        <h2 id={s.id} class="label sec-title">{s.title}</h2>
        <ol class="entries" role="list">
          {s.items.map((e) => (
            <li data-reveal>
              <p class="period label"><Field value={e.period} /></p>
              <div>
                <h3 class="e-title"><Field value={e.role ?? e.title} /></h3>
                <p class="org"><Field value={e.org} /></p>
                {e.description && <p class="desc"><Field value={e.description} /></p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}

    <div class="cv-sec two">
      <section aria-labelledby="idiomas">
        <h2 id="idiomas" class="label sec-title">Idiomas</h2>
        <ul class="langs" role="list">
          {cv.languages.map((l) => <li><span>{l.name}</span><span class="muted"><Field value={l.level} /></span></li>)}
        </ul>
      </section>
      <section aria-labelledby="areas">
        <h2 id="areas" class="label sec-title">Áreas</h2>
        <ul class="chips" role="list">{habilidades.groups.map((g) => <li class="chip">{g.title}</li>)}</ul>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelector<HTMLButtonElement>('[data-print]')?.addEventListener('click', () => window.print());
  });
</script>

<style>
  .head { padding-block: clamp(3rem, 7vw, 6rem) clamp(2.5rem, 6vw, 4.5rem); }
  .head-row { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; }
  .head .display { color: var(--navy); margin-top: 1.25rem; }
  .head .lead { margin-top: 2rem; max-width: 50ch; }
  .print-only { display: none; }

  .cv-sec { display: grid; grid-template-columns: 1fr 3fr; gap: var(--gutter); border-top: 1px solid var(--line-strong); padding-block: 1.5rem clamp(2.5rem, 5vw, 4rem); }
  .sec-title { color: var(--ink); padding-top: 0.25rem; }
  .entries { list-style: none; padding: 0; }
  .entries li { display: grid; grid-template-columns: 11rem 1fr; gap: var(--gutter); padding-block: 1.25rem; }
  .entries li + li { border-top: 1px solid var(--line); }
  .period { padding-top: 0.35rem; text-transform: none; letter-spacing: 0.02em; }
  .e-title { font-size: var(--step-1); letter-spacing: -0.025em; line-height: 1.2; }
  .org { color: var(--violet); font-weight: 500; margin-top: 0.2rem; }
  .desc { color: var(--muted); margin-top: 0.6rem; max-width: 60ch; }
  .two { grid-template-columns: 1fr 1fr; }
  .two .sec-title { margin-bottom: 1rem; }
  .langs { list-style: none; padding: 0; }
  .langs li { display: flex; justify-content: space-between; padding-block: 0.6rem; border-bottom: 1px solid var(--line); font-weight: 500; max-width: 26rem; }

  @media (max-width: 860px) {
    .cv-sec, .two { grid-template-columns: 1fr; }
    .entries li { grid-template-columns: 1fr; gap: 0.25rem; }
  }
  @media print {
    .print-only { display: block; margin-bottom: 1rem; }
    .head .display { display: none; }
    .head .label { display: none; }
    .head { padding: 0; }
  }
</style>
