---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';
import { useTranslations } from '../../i18n/ui';

const t = useTranslations('es');
const projects = await getProjects('es');
const types = [...new Set(projects.map((p) => p.data.type))];
---
<BaseLayout title="Proyectos" description="Proyectos de creación de contenido, branding y marketing de Iker Roque: personales, académicos y conceptuales.">
  <section class="container page-head">
    <p class="label" data-reveal>Portfolio · {String(projects.length).padStart(2, '0')} proyectos</p>
    <h1 class="display" data-reveal style="--i:1">Proyec<span class="serif accent">tos</span></h1>
    <p class="lead" data-reveal style="--i:2">
      Ideas que he llevado del concepto a la ejecución. Cada proyecto indica si es personal, académico o conceptual.
    </p>

    <div class="filters" role="group" aria-label="Filtrar por tipo" data-reveal style="--i:3">
      <button class="filter" aria-pressed="true" data-filter="all">{t('filter.all')}</button>
      {types.map((ty) => (
        <button class="filter" aria-pressed="false" data-filter={ty}>{t(`type.${ty}`)}</button>
      ))}
    </div>
  </section>

  <section class="container">
    <ul class="list" role="list">
      {projects.map((p, i) => (
        <li data-type={p.data.type}>
          <ProjectCard project={p} index={i + 1} eager={i < 2} />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<script>
  function initFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = document.querySelectorAll<HTMLElement>('.list > li');
    buttons.forEach((btn) => {
      btn.onclick = () => {
        const f = btn.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        items.forEach((li) => { li.hidden = f !== 'all' && li.dataset.type !== f; });
      };
    });
  }
  document.addEventListener('astro:page-load', initFilters);
</script>

<style>
  .page-head { padding-block: clamp(3rem, 7vw, 6rem) clamp(2.5rem, 5vw, 4rem); }
  .page-head .display { color: var(--navy); margin-block: 1.25rem 1.5rem; }
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2.5rem; }
  .filter {
    padding: 0.6rem 1rem; border-radius: 999px; font-size: 0.9rem; font-weight: 500;
    box-shadow: inset 0 0 0 1px var(--line); transition: all 0.3s var(--ease);
  }
  .filter:hover { box-shadow: inset 0 0 0 1px var(--violet); color: var(--violet); }
  .filter[aria-pressed='true'] { background: var(--navy); color: var(--white); box-shadow: none; }
  .list {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: clamp(3rem, 6vw, 5rem) var(--gutter); list-style: none; padding: 0;
  }
  .list > li:nth-child(even) { margin-top: clamp(0rem, 8vw, 7rem); }
  .list > li[hidden] { display: none; }
  @media (max-width: 760px) {
    .list { grid-template-columns: 1fr; }
    .list > li:nth-child(even) { margin-top: 0; }
  }
</style>
