---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cover from '../../components/Cover.astro';
import Tag from '../../components/Tag.astro';
import Field from '../../components/Field.astro';
import habilidades from '../../data/habilidades.json';
import { getProjects, slugOf, isTodo, type Project } from '../../lib/content';
import { routes, useTranslations } from '../../i18n/ui';

export async function getStaticPaths() {
  const projects = await getProjects('es');
  return projects.map((project, i) => ({
    params: { slug: slugOf(project.id) },
    props: { project, index: i + 1, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props { project: Project; index: number; next: Project }
const { project, index, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const t = useTranslations('es');
const r = routes.es;
const slug = slugOf(project.id);
const skills = habilidades.groups.filter((g) => data.skills.includes(g.id));
const nextSlug = slugOf(next.id);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.seoDescription ?? data.summary,
  author: { '@type': 'Person', name: 'Iker Roque' },
  url: new URL(`${r.projects}/${slug}`, Astro.site).toString(),
};
---
<BaseLayout title={data.title} description={data.seoDescription ?? data.summary} image={data.cover ?? '/og.png'} type="article" jsonLd={jsonLd}>
  <article>
    <header class="container head">
      <a href={r.projects} class="label back link">← {t('project.all')}</a>
      <div class="head-grid">
        <div>
          <p class="label num" data-reveal>{String(index).padStart(2, '0')}</p>
          <h1 class="display title" data-reveal style="--i:1">{data.title}<span class="t-dot" aria-hidden="true"></span></h1>
        </div>
        <p class="lead summary" data-reveal style="--i:2">{data.summary}</p>
      </div>

      <dl class="facts" data-reveal style="--i:3">
        <div><dt class="label">{t('project.type')}</dt><dd><Tag type={data.type} status={data.status} /></dd></div>
        {data.role && <div><dt class="label">{t('project.role')}</dt><dd><Field value={data.role} /></dd></div>}
        {data.year && <div><dt class="label">{t('project.year')}</dt><dd>{data.year}</dd></div>}
        {data.tools.length > 0 && <div><dt class="label">{t('project.tools')}</dt><dd>{data.tools.join(', ')}</dd></div>}
      </dl>
    </header>

    <div class="container hero-cover" style={`view-transition-name: cover-${slug}`}>
      <Cover title={data.title} cover={data.cover} alt={data.coverAlt} tone={data.tone} index={index} eager label={data.scope[0]} />
    </div>

    <div class="container body">
      <aside class="side">
        {data.scope.length > 0 && (
          <section>
            <h2 class="label">{t('project.scope')}</h2>
            <ul class="scope" role="list">{data.scope.map((s) => <li>{s}</li>)}</ul>
          </section>
        )}
        {skills.length > 0 && (
          <section>
            <h2 class="label">{t('project.skills')}</h2>
            <ul class="chips" role="list">{skills.map((s) => <li class="chip"><a href={`${r.skills}#${s.id}`}>{s.title}</a></li>)}</ul>
          </section>
        )}
        {data.link && <a href={data.link} class="btn btn-primary" target="_blank" rel="noopener noreferrer">{t('project.link')} <span class="arrow">↗</span></a>}
      </aside>

      <div class="main">
        {data.challenge && (
          <section class="block">
            <h2 class="label">{t('project.challenge')}</h2>
            <p class="h3 challenge"><Field value={data.challenge} /></p>
          </section>
        )}

        <section class="block prose"><Content /></section>

        {data.process.length > 0 && (
          <section class="block">
            <h2 class="label">{t('project.process')}</h2>
            <ol class="process" role="list">
              {data.process.map((s, i) => (
                <li><span class="label">{String(i + 1).padStart(2, '0')}</span><h3>{s.title}</h3><p>{s.text}</p></li>
              ))}
            </ol>
          </section>
        )}

        {data.results.length > 0 && (
          <section class="block">
            <h2 class="label">{t('project.results')}</h2>
            <ul class="results" role="list">{data.results.map((x) => <li>{x}</li>)}</ul>
          </section>
        )}

        {data.learnings && !isTodo(data.learnings) && (
          <section class="block">
            <h2 class="label">{t('project.learnings')}</h2>
            <p class="prose">{data.learnings}</p>
          </section>
        )}
      </div>
    </div>

    {data.gallery.length > 0 && (
      <section class="container gallery">
        {data.gallery.map((g) => (
          <figure data-reveal>
            {/\.(mp4|webm|mov)$/i.test(g.src)
              ? <video src={g.src} controls playsinline preload="metadata" aria-label={g.alt}></video>
              : <img src={g.src} alt={g.alt} loading="lazy" decoding="async" />}
            {g.caption && <figcaption class="label">{g.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )}

    <nav class="container next" aria-label={t('project.next')}>
      <a href={`${r.projects}/${nextSlug}`}>
        <span class="label">{t('project.next')}</span>
        <span class="next-title">{next.data.title} <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .head { padding-top: clamp(2rem, 5vw, 3.5rem); }
  .back { display: inline-block; margin-bottom: clamp(2rem, 5vw, 4rem); }
  .head-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--gutter); align-items: end; }
  .title { color: var(--navy); margin-top: 0.75rem; }
  .t-dot { display: inline-block; width: 0.16em; height: 0.16em; border-radius: 50%; background: var(--violet); margin-left: 0.04em; }
  .summary { padding-bottom: 0.6rem; }
  .facts {
    display: flex; flex-wrap: wrap; gap: 1.5rem 3.5rem;
    border-top: 1px solid var(--line-strong); margin-top: clamp(2rem, 5vw, 3.5rem); padding-block: 1.25rem 2.5rem;
  }
  .facts dd { margin-top: 0.4rem; font-weight: 500; }
  .hero-cover :global(.cover) { aspect-ratio: 16 / 8; }

  .body { display: grid; grid-template-columns: 1fr 2fr; gap: var(--gutter); padding-block: clamp(3rem, 8vw, 7rem); }
  .side { display: flex; flex-direction: column; gap: 2.5rem; align-self: start; position: sticky; top: 6.5rem; }
  .side h2 { margin-bottom: 1rem; }
  .scope { list-style: none; padding: 0; }
  .scope li { padding-block: 0.6rem; border-bottom: 1px solid var(--line); font-weight: 500; display: flex; gap: 0.6rem; align-items: center; }
  .scope li::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--violet); flex: none; }
  .chip a:hover { color: var(--violet); }

  .block + .block { margin-top: clamp(3rem, 6vw, 4.5rem); }
  .block > h2.label { margin-bottom: 1.25rem; }
  .challenge { color: var(--navy); font-weight: 500; line-height: 1.2; }

  .process { list-style: none; padding: 0; display: grid; gap: 0; }
  .process li { display: grid; grid-template-columns: 3rem 1fr; gap: 0.25rem 1rem; padding-block: 1.25rem; border-top: 1px solid var(--line); }
  .process h3 { font-size: var(--step-1); letter-spacing: -0.02em; }
  .process p { grid-column: 2; color: var(--muted); }
  .results { list-style: none; padding: 0; display: grid; gap: 0.75rem; }
  .results li { font-size: var(--step-1); padding-left: 1.5rem; position: relative; }
  .results li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 8px; height: 8px; border-radius: 50%; background: var(--violet); }

  .gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--gutter); }
  .gallery figure:first-child { grid-column: 1 / -1; }
  .gallery img, .gallery video { width: 100%; border-radius: var(--radius); }
  .gallery figcaption { margin-top: 0.6rem; }

  .next { padding-top: clamp(4rem, 8vw, 7rem); }
  .next a { display: block; border-top: 1px solid var(--line-strong); padding-top: 1.25rem; }
  .next-title { display: block; font-size: var(--step-4); font-weight: 600; letter-spacing: -0.05em; color: var(--navy); margin-top: 0.75rem; transition: color 0.3s; }
  .next a:hover .next-title { color: var(--violet); }
  .next .arrow { display: inline-block; transition: transform 0.4s var(--ease); }
  .next a:hover .arrow { transform: translateX(0.2em); }

  @media (max-width: 860px) {
    .head-grid, .body { grid-template-columns: 1fr; }
    .side { position: static; order: 2; }
    .hero-cover :global(.cover) { aspect-ratio: 4 / 3; }
    .gallery { grid-template-columns: 1fr; }
  }
</style>
